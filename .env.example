# ===========================================
# VB Bank - Playwright Test Environment Config
# ===========================================

# Application URL
BASE_URL=https://vb-bank-demo.vercel.app

# Test Timeouts (in milliseconds)
DEFAULT_TIMEOUT=30000
NAVIGATION_TIMEOUT=30000
EXPECT_TIMEOUT=10000

# Browser Config
HEADLESS=true
SLOW_MO=0

# Retry Config
RETRIES=1
WORKERS=2

# qa-sentinel — AI failure analysis (optional, enables AI-powered fix suggestions)
# Priority order: Anthropic > OpenAI > Gemini
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
GEMINI_API_KEY=

# qa-sentinel Pro license key (optional, unlocks PDF export, extra themes, quality gates)
# QA_SENTINEL_LICENSE_KEY=
